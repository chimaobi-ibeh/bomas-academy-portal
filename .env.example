# Copy to .env for local development. Never commit real values.
# In production, set these in Vercel: Project > Settings > Environment Variables.

# --- Existing ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=bomasacademy@gmail.com
CONTACT_FROM_EMAIL="Bomas Academy Website <noreply@bomasacademy.org>"

# --- Online admissions (all server-only) ---
# Online payment stays OFF until PAYMENT_PROVIDER, its key, ADMISSION_FEE_NGN and
# ADMISSIONS_LINK_SECRET are all set.
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_test_...
# Paystack subaccount codes, one per school bank account. Nursery/primary classes pay into the
# first, JSS/SSS classes into the second. Payment stays off until both are set.
PAYSTACK_SUBACCOUNT_NURSERY_PRIMARY=ACCT_...
PAYSTACK_SUBACCOUNT_SECONDARY=ACCT_...
# Application fee in naira (whole number), e.g. 10000. Not yet confirmed by the school.
ADMISSION_FEE_NGN=
# 32+ random characters. Signs the private links sent by email. Changing it revokes all links.
ADMISSIONS_LINK_SECRET=
# Optional overrides
ADMISSIONS_TO_EMAIL=bomasacademy@gmail.com
ADMISSIONS_FROM_EMAIL="Bomas Academy Admissions <noreply@bomasacademy.org>"
SITE_URL=https://www.bomasacademy.org
# Protects the daily /api/admissions/reconcile job (Vercel sends it automatically).
CRON_SECRET=
